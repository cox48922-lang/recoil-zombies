local function gethum() local c = LocalPlayer.Character return c and c:FindFirstChildOfClass("Humanoid") end
local function gethrp() local c = LocalPlayer.Character return c and c:FindFirstChild("HumanoidRootPart") end

local speedConn

local function stopSpeed()
    if speedConn then speedConn:Disconnect(); speedConn = nil end
end

local function startSpeed()
    stopSpeed()
    speedConn = RunService.Heartbeat:Connect(function(dt)
        if cfg.fly or not cfg.speedBoost then return end
        local hrp = gethrp()
        local hum = gethum()
        if not hrp or not hum then return end

        local mv = hum.MoveDirection
        if mv.Magnitude < 0.1 then return end

        local speedRatio = cfg.walkSpeed / 16
        local baseSpeed  = 16 * dt
        local extra      = (speedRatio - 1) * baseSpeed

        hrp.CFrame = hrp.CFrame + mv * extra
    end)
end

startSpeed()
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    if cfg.speedBoost then startSpeed() end
end)

