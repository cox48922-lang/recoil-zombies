RunService.RenderStepped:Connect(function()
    local sc = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    if cfg.showFOV then
        fovcircle.Visible  = true
        fovcircle.Radius   = cfg.aimbotFOV
        fovcircle.Position = sc
        fovcircle.Color    = (cfg.aimbot and aimboton) and Color3.fromRGB(60,255,60) or Color3.fromRGB(210,210,210)
    else
        fovcircle.Visible = false
    end
    if cfg.aimbot and aimboton then
        local target = gettarget()
        if target then
            currenttarget = target
            local campos = Camera.CFrame.Position
            local dir    = (target.Position - campos).Unit
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(campos, campos + dir), cfg.aimbotSmooth)
        else currenttarget = nil end
    else currenttarget = nil end
end)

