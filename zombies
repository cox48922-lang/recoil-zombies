end)

local flyConn2
local flyV     = Vector3.zero
local flyActive = false

local function stopfly()
    flyActive = false
    if flyConn2 then flyConn2:Disconnect(); flyConn2 = nil end
    flyV = Vector3.zero
    local hum = gethum()
    local hrp = gethrp()
    if hum then
        hum.PlatformStand = false
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
    if hrp then
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end

local function startfly()
    stopfly()
    local hrp = gethrp()
    local hum = gethum()
    if not hrp or not hum then return end
    flyActive = true

    pcall(function() hrp:SetNetworkOwner(LocalPlayer) end)

    flyConn2 = RunService.RenderStepped:Connect(function(dt)
        if not flyActive then return end
        local hrp2 = gethrp()
        local hum2 = gethum()
        if not hrp2 or not hum2 then stopfly(); return end

        hum2.PlatformStand = false
        hrp2.AssemblyLinearVelocity  = Vector3.zero
        hrp2.AssemblyAngularVelocity = Vector3.zero

        local cf    = Camera.CFrame
        local input = Vector3.zero

        if UIS:IsKeyDown(Enum.KeyCode.W) then input += cf.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then input -= cf.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then input -= cf.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then input += cf.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space)     then input += Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then input -= Vector3.new(0, 1, 0) end

        local target = (input.Magnitude > 0 and input.Unit or Vector3.zero) * cfg.flySpeed
        flyV = flyV:Lerp(target, math.min(1, dt * 10))

        hrp2.CFrame = CFrame.new(hrp2.CFrame.Position + flyV * dt)
            * CFrame.Angles(0, math.atan2(-cf.LookVector.X, -cf.LookVector.Z), 0)

        local c = LocalPlayer.Character
        if c then
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") and p ~= hrp2 then
                    p.CanCollide = false
                end
            end
        end
    end)
end

toggle(playertab.page, "Fly", "fly", function(v)
    if v then startfly() else stopfly() end
end)

