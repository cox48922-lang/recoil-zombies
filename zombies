    local dragging = false
    local function updatefromx(absx)
        local pct = math.clamp((absx - trackbg.AbsolutePosition.X) / trackbg.AbsoluteSize.X, 0, 1)
        local val
        if isfloat then
            val = math.floor((minval + (maxval - minval) * pct) * 100 + 0.5) / 100
        else
            val = math.floor(minval + (maxval - minval) * pct)
        end
        cfg[key]      = val
        fillbar.Size  = UDim2.fromScale(pct, 1)
        vallbl.Text   = fmt(val)
        if callback then callback(val) end
    end

    trackbg.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; updatefromx(i.Position.X) end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then updatefromx(i.Position.X) end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    row.MouseEnter:Connect(function() tween(row, {BackgroundColor3 = c.HOVER}, 0.12) end)
    row.MouseLeave:Connect(function() tween(row, {BackgroundColor3 = c.PANEL}, 0.12) end)
end

