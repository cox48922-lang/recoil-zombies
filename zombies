local function line(color, thick)
    local l = Drawing.new("Line")
    l.Visible = false; l.Color = color; l.Thickness = thick; l.Transparency = 1
    return l
end

local function text(size, color)
    local t = Drawing.new("Text")
    t.Visible = false; t.Size = size or 13; t.Color = color or Color3.new(1,1,1)
    t.Outline = true; t.OutlineColor = Color3.new(0,0,0); t.Font = Drawing.Fonts.UI
    return t
end

local function w2s(pos)
    local sp, on = Camera:WorldToViewportPoint(pos)
    return Vector2.new(sp.X, sp.Y), on, sp.Z
end

local rayparams = RaycastParams.new()
rayparams.FilterType  = Enum.RaycastFilterType.Blacklist
rayparams.IgnoreWater = true

local function visible(part)
    if not cfg.visCheck then return true end
    if not part or not part.Parent then return false end
    local ignore = {folder}
    if LocalPlayer.Character then table.insert(ignore, LocalPlayer.Character) end
    local vis = workspace:FindFirstChild("Vis")
    if vis then table.insert(ignore, vis) end
    table.insert(ignore, Camera)
    rayparams.FilterDescendantsInstances = ignore
    local result = workspace:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, rayparams)
    return result == nil
end

local function gettarget()
    local best, bestdist = nil, math.huge
    local sc = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, zombie in ipairs(folder:GetChildren()) do
        if not zombie:IsA("Model") then continue end
        local candidates = {}
        for _, p in ipairs(zombie:GetChildren()) do
            if p.Name == "Head" and p:IsA("BasePart") then table.insert(candidates, p) end
        end
        if #candidates == 0 then
            local t = zombie:FindFirstChild("UpperTorso")
            if t and t:IsA("BasePart") then table.insert(candidates, t) end
        end
        for _, part in ipairs(candidates) do
            if (part.Position - Camera.CFrame.Position).Magnitude < 10 then continue end
            local sp, _, depth = w2s(part.Position)
            if depth > 0 then
                local d = (sp - sc).Magnitude
                if d < cfg.aimbotFOV and d < bestdist then bestdist = d; best = part end
            end
        end
    end
    return best
end

local function updatevis()
    for _, hitbox in pairs(hitboxes) do
        if hitbox and hitbox.Parent then
            hitbox.Transparency = cfg.hitboxVisuals and 0.7 or 1
            hitbox.Material     = cfg.hitboxVisuals and Enum.Material.Neon or Enum.Material.Air
            hitbox.Color        = cfg.hitboxVisuals and Color3.fromRGB(255,60,60) or Color3.new(0,0,0)
        end
    end
end

local function createhitbox(zombie)
    if not zombie or not zombie.Parent or tracked[zombie] then return end
    local torso = zombie:FindFirstChild("UpperTorso") or zombie:FindFirstChild("LowerTorso")
    if not torso then return end
    local hitbox = Instance.new("Part")
    hitbox.Name          = "ExpandedHitbox_" .. zombie.Name
    hitbox.Size          = torso.Size + Vector3.new(cfg.hitboxSize, cfg.hitboxSize, cfg.hitboxSize)
    hitbox.CFrame        = torso.CFrame
    hitbox.Anchored      = false
    hitbox.CanCollide    = false
    hitbox.TopSurface    = Enum.SurfaceType.Smooth
    hitbox.BottomSurface = Enum.SurfaceType.Smooth
    hitbox.Transparency  = cfg.hitboxVisuals and 0.7 or 1
    hitbox.Material      = cfg.hitboxVisuals and Enum.Material.Neon or Enum.Material.Air
    hitbox.Color         = cfg.hitboxVisuals and Color3.fromRGB(255,60,60) or Color3.new(0,0,0)
    hitbox.Parent        = zombie
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = torso; weld.Part1 = hitbox; weld.Parent = hitbox
    hitboxes[zombie] = hitbox
    tracked[zombie]  = true
end

local function enablehitbox()
    for _, z in ipairs(folder:GetChildren()) do
        if z:IsA("Model") then createhitbox(z) end
    end
end

local function disablehitbox()
    for _, hitbox in pairs(hitboxes) do if hitbox then hitbox:Destroy() end end
    hitboxes = {}; tracked = {}
end

local function updatesizes()
    for zombie, hitbox in pairs(hitboxes) do
        if hitbox and hitbox.Parent then
            local torso = zombie:FindFirstChild("UpperTorso") or zombie:FindFirstChild("LowerTorso")
            if torso then hitbox.Size = torso.Size + Vector3.new(cfg.hitboxSize, cfg.hitboxSize, cfg.hitboxSize) end
        end
    end
end

local function setup(model)
    if processed[model] then return end
    processed[model] = true

    local bonelines = {}
    for _, pair in ipairs(bones) do
        local a = model:FindFirstChild(pair[1])
        local b = model:FindFirstChild(pair[2])
        if a and b then table.insert(bonelines, {a=a, b=b, line=line(cfg.skeletonColor, cfg.skeletonThick)}) end
    end

    local boxlines = {}
    for i = 1, 8 do table.insert(boxlines, line(cfg.boxColor, cfg.boxThick)) end
    local dtext = text(11, cfg.distColor)

    local function hide()
        for _, b in ipairs(bonelines) do b.line.Visible = false end
        for _, l in ipairs(boxlines)  do l.Visible = false end
        dtext.Visible = false
    end

    local function cleanup()
        for _, b in ipairs(bonelines) do b.line:Remove() end
        for _, l in ipairs(boxlines)  do l:Remove() end
        dtext:Remove(); processed[model] = nil
    end

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not model or not model.Parent then conn:Disconnect(); cleanup(); return end
        local root = model:FindFirstChild("UpperTorso") or model:FindFirstChild("LowerTorso")
        if not root then hide(); return end
        local worlddist = (root.Position - Camera.CFrame.Position).Magnitude
        if worlddist < 10 or worlddist > cfg.maxDist then hide(); return end
        local _, _, depth = w2s(root.Position)
        if depth <= 0 then hide(); return end

        local vis  = visible(root)
        local color = vis and cfg.visibleColor or cfg.hiddenColor

        for _, bone in ipairs(bonelines) do
            if cfg.skeleton then
                local sa, _, da = w2s(bone.a.Position)
                local sb        = w2s(bone.b.Position)
                bone.line.Color = color; bone.line.From = sa; bone.line.To = sb; bone.line.Visible = da > 0
            else bone.line.Visible = false end
        end

        local head  = model:FindFirstChild("Head")
        local lfoot = model:FindFirstChild("LeftFoot")
        local rfoot = model:FindFirstChild("RightFoot")
        local foot  = lfoot or rfoot

        if head and foot then
            local headpart = nil
            for _, p in ipairs(model:GetChildren()) do
                if p.Name == "Head" and p:IsA("BasePart") then headpart = p; break end
            end
            headpart = headpart or head
            local toppos = headpart.Position + Vector3.new(0, headpart.Size.Y / 2, 0)
            local botpos = foot.Position     - Vector3.new(0, foot.Size.Y      / 2, 0)
            local tops, _, dtop = w2s(toppos)
            local bots, _, dbot = w2s(botpos)

            if dtop > 0 and dbot > 0 then
                local bh = bots.Y - tops.Y
                local bw = bh * 0.4
                local cx = tops.X
                local bx = cx - bw * 0.5
                local by = tops.Y
                local tw = bw * 0.28
                local th  = bh * 0.22

                if cfg.boxes then
                    local pts = {
                        {Vector2.new(bx,by),       Vector2.new(bx+tw,by)},
                        {Vector2.new(bx,by),       Vector2.new(bx,by+th)},
                        {Vector2.new(bx+bw,by),    Vector2.new(bx+bw-tw,by)},
                        {Vector2.new(bx+bw,by),    Vector2.new(bx+bw,by+th)},
                        {Vector2.new(bx,by+bh),    Vector2.new(bx+tw,by+bh)},
                        {Vector2.new(bx,by+bh),    Vector2.new(bx,by+bh-th)},
                        {Vector2.new(bx+bw,by+bh), Vector2.new(bx+bw-tw,by+bh)},
                        {Vector2.new(bx+bw,by+bh), Vector2.new(bx+bw,by+bh-th)},
                    }
                    for i, p in ipairs(pts) do
                        boxlines[i].Color = color; boxlines[i].From = p[1]; boxlines[i].To = p[2]; boxlines[i].Visible = true
                    end
                else
                    for _, l in ipairs(boxlines) do l.Visible = false end
                end

                if cfg.distance then
                    local label = math.floor(worlddist) .. "m"
                    dtext.Text = label; dtext.Color = color
                    dtext.Position = Vector2.new(cx - (#label * 3.2), by + bh + 3)
                    dtext.Visible = true
                else dtext.Visible = false end
            else
                for _, l in ipairs(boxlines) do l.Visible = false end
                dtext.Visible = false
            end
        else
            for _, l in ipairs(boxlines) do l.Visible = false end
            dtext.Visible = false
        end
    end)

    model.AncestryChanged:Connect(function(_, parent)
        if not parent then conn:Disconnect(); cleanup() end
    end)
end

