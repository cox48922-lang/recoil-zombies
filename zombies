local function tab(name, order)
    local t = {}
    local btn = Instance.new("TextButton")
    btn.Size                = UDim2.new(1, 0, 0, 30)
    btn.BackgroundColor3    = c.PANEL
    btn.BackgroundTransparency = 1
    btn.Text                = name
    btn.TextColor3          = c.DIM
    btn.TextSize            = 11
    btn.Font                = Enum.Font.Gotham
    btn.BorderSizePixel     = 0
    btn.LayoutOrder         = order
    btn.Parent              = side
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)

    local page = Instance.new("ScrollingFrame")
    page.Size                = UDim2.fromScale(1, 1)
    page.BackgroundTransparency = 1
    page.Visible             = false
    page.ScrollBarThickness  = 3
    page.ScrollBarImageColor3 = Color3.fromRGB(80,80,80)
    page.CanvasSize          = UDim2.new(0,0,0,0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.BorderSizePixel     = 0
    page.Parent              = content

    local pl = Instance.new("UIListLayout")
    pl.SortOrder = Enum.SortOrder.LayoutOrder
    pl.Padding   = UDim.new(0, 6)
    pl.Parent    = page

    local pp = Instance.new("UIPadding")
    pp.PaddingTop    = UDim.new(0, 12)
    pp.PaddingLeft   = UDim.new(0, 12)
    pp.PaddingRight  = UDim.new(0, 12)
    pp.PaddingBottom = UDim.new(0, 12)
    pp.Parent        = page

    t.btn  = btn
    t.page = page

    local function on()
        if activetab and activetab ~= t then
            tween(activetab.btn, {TextColor3 = c.DIM, BackgroundTransparency = 1}, 0.15)
            activetab.page.Visible = false
        end
        activetab = t
        tween(btn, {TextColor3 = c.TEXT, BackgroundTransparency = 0.92}, 0.15)
        page.Visible = true
    end

    btn.MouseButton1Click:Connect(on)
    btn.MouseEnter:Connect(function() if activetab ~= t then tween(btn, {BackgroundTransparency = 0.96}, 0.12) end end)
    btn.MouseLeave:Connect(function() if activetab ~= t then tween(btn, {BackgroundTransparency = 1}, 0.12) end end)
    t.activate = on
    return t
end

